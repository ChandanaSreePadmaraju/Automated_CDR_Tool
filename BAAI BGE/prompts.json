{
    "model_name": "BAAI/bge-base-en-v1.5",
    "query_prefix": "Represent this sentence for searching relevant passages: ",
    "threshold": 0.6,
    "product_name": "Azurion HW R3",

    "heading_mappings": {
        "Compliance Checklist": "Test Record",
        "Record history": "Document Revision History"
    },

    "sections_remap_table_columns": {
        "Record history": [0, 1, 2, 3],
        "References": [0, 2, 1],
        "Definitions & abbreviations": [0, 1]
    },

    "sections_keep_first_n_tables": {"Compliance Checklist": 1},

    "sections_keep_template_content": ["Purpose", "Scope"],

    "sections_filter_heading_content": [],

    "post_processing": {
        "styles_to_remove": ["Guidance"],
        "remove_template_instructions": true,
        "strip_inline_angle_brackets": true,
        "remove_paragraphs_with_text": [
            "Note: for template information, see custom properties of this document"
        ],
        "remove_preamble_before_first_heading": true,
        "remove_empty_table_rows": true,
        "note_text_prefixes": ["NOTE"],
        "note_text_size_half_pt": 16,
        "strip_superscript_list_markers": true,
        "set_all_text_black": true,
        "remove_blank_para_after_headings": true,
        "sort_table_alphabetically_under_headings": [
            "References",
            "Definitions & abbreviations"
        ],
        "definitions_fixed_rows": [
            ["CDR",   "Compliance Data Record"],
            ["ISO",   "International Standardization Organization"],
            ["IGT-S", "Image Guided Therapy - Systems"]
        ],
        "definitions_heading": "Definitions & abbreviations",
        "remove_sections": [
            "Pre-created CDR history",
            "Test Administration"
        ],
        "remove_headings_only": [
            "Test Measurements",
            "Test Result"
        ],
        "compliance_table_header": {
            "heading": "Compliance Checklist",
            "columns": [
                "ISO 17664-2 / Cl.",
                "Requirement \u2013 Test",
                "Result \u2013 Reference \u2013 Remark",
                "Verdict"
            ]
        },
        "header_footer_placeholders": [
            "<ProductName RX.Y>"
        ],
        "normalize_rfonts_remove_attributes": ["eastAsia", "eastAsiaTheme", "cs"],
        "fill_table_from_source": {
            "target_heading": "Compliance Checklist",
            "source_heading": "Test Administration",
            "row_label_map": {
                "Model/Type reference:": "Sample Type (Identification of Design)",
                "Ratings:":             "Ratings",
                "Copy of marking plate:": "Copy of marking plate:",
                "General product information:": "General product information:",
                "The product fulfils the requirements of ISO 17664-2:": "The product fulfils the requirements of ISO 17664-2:"
            }
        }
    }
}
